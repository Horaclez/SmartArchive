<Window x:Class="SmartArchive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Smart Archive" Width="1080" Height="680" AllowDrop="True" Drop="OnDrop"
        Icon="pack://application:,,,/assets/icon.ico">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fila 1: abrir / extraer -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
      <Button Content="Abrir…" Padding="12,5" Margin="0,0,6,0" Click="BtnOpen_Click"/>
      <Button Content="🔑 Abrir con contraseña…" Padding="12,5" Margin="0,0,6,0" Click="BtnPwd_Click"/>
      <Button x:Name="BtnExtract" Content="Extraer aquí" Padding="12,5" Margin="0,0,6,0" IsEnabled="False" Click="BtnExtract_Click"/>
      <Button x:Name="BtnRun" Content="Extraer y abrir" Padding="12,5" Margin="0,0,14,0" IsEnabled="False" Click="BtnRun_Click"/>
      <CheckBox x:Name="ChkRecycle" Content="Mandar comprimido a la Papelera" IsChecked="True" VerticalAlignment="Center"/>
    </WrapPanel>

    <!-- Fila 2: comprimir -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="Comprimir carpeta:" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="FormatBox" Width="70" SelectedIndex="0" Margin="0,0,6,0">
        <ComboBoxItem Content="ZIP"/>
        <ComboBoxItem x:Name="Fmt7z" Content="7z"/>
      </ComboBox>
      <TextBlock Text="Contraseña (opcional):" VerticalAlignment="Center" Margin="6,0,6,0"/>
      <PasswordBox x:Name="PwdBox" Width="140" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
      <Button Content="Elegir carpeta y comprimir…" Padding="12,5" Margin="0,0,14,0" Click="BtnZip_Click"/>
      <CheckBox x:Name="ChkIgnore" Content="Ignorar basura (.git, node_modules, bin, obj, __pycache__, .tmp)" IsChecked="True" VerticalAlignment="Center"/>
    </WrapPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListView x:Name="Lst" SelectionChanged="Lst_Sel">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Nombre" Width="340" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="Tamaño" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
          </GridView>
        </ListView.View>
      </ListView>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1">
        <Grid>
          <TextBox x:Name="TxtBox" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" BorderThickness="0"/>
          <Image x:Name="ImgBox" Stretch="Uniform" Visibility="Collapsed"/>
          <wv:WebView2 x:Name="PdfView" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <ProgressBar x:Name="Bar" Height="14" Maximum="100"/>
      <TextBlock x:Name="Status" Margin="0,4,0,0" TextWrapping="Wrap" Text="Arrastra uno o varios .zip/.rar/.7z aquí (varios = extracción en lote), o una carpeta para comprimirla."/>
    </StackPanel>
  </Grid>
</Window>
